# fitd26 compose-level environment. Copy to `.env` in THIS directory and fill in.
# docker compose reads `.env` from the project directory automatically and
# substitutes these into docker-compose.yml. Never commit the real `.env`.

# ---------------------------------------------------------------------------
# Public domains (Cloudflare Tunnel terminates TLS; Traefik routes on Host).
# DOMAIN is the apex; APP_DOMAIN is usually the same value (kept separate for
# flexibility). The backend/API is reached at backend.${DOMAIN}.
# ---------------------------------------------------------------------------
DOMAIN=flutterinthedark.dev
APP_DOMAIN=flutterinthedark.dev

# ---------------------------------------------------------------------------
# Docker socket that Traefik mounts to discover containers by label.
# *** THIS IS THE #1 STARTUP GOTCHA ***
#   - Linux event host : /var/run/docker.sock        (the default; leave unset)
#   - Docker Desktop Mac: /Users/YOU/.docker/run/docker.sock
# On Docker Desktop, /var/run/docker.sock does NOT exist on the macOS host.
# Mounting that nonexistent path makes Docker create a junk mount, and Traefik
# then fails every daemon read with an EMPTY "Error response from daemon:" and
# builds ZERO routers (public edge 404/502s). Find yours with:
#     docker context inspect --format '{{json .Endpoints.docker.Host}}'
# (strip the leading unix://). The in-container target stays /var/run/docker.sock.
# ---------------------------------------------------------------------------
# DOCKER_SOCK=/var/run/docker.sock
# DOCKER_SOCK=/Users/lohnn/.docker/run/docker.sock

# ---------------------------------------------------------------------------
# Tailscale admin gate (structural /admin). Traefik binds the admin entrypoint
# to this host's tailscale0 IPv4 only; /admin + /api/admin/* exist ONLY there
# (no public router). Fails fast at `up` if unset — intentional.
#   Get it with: tailscale ip -4
# ---------------------------------------------------------------------------
TAILSCALE_IP=100.x.x.x

# Directory holding the tailnet TLS cert for the admin edge (issued by
# `tailscale cert <machine>.<tailnet>.ts.net`, renamed to tailscale.crt/.key).
# Defaults to ~/.tailscale-certs if unset.
# TAILSCALE_CERT_DIR=/Users/you/.tailscale-certs

# ---------------------------------------------------------------------------
# dart-pad fork checkout (the self-host compile backend, branch berget-backend).
# Build context for the dart-services image is the dart-pad repo ROOT.
# Defaults to a sibling ../dart-pad checkout.
# DART_PAD_PATH=../dart-pad

# REQUIRED, no default: ABSOLUTE path of deploy/Dockerfile.dart-services in THIS
# checkout. dockerfile: resolves relative to the build CONTEXT (the dart-pad
# repo), and there is no folder-name-agnostic relative path back into this repo
# (your sibling folder may be flutter-in-the-dark OR flutter_in_the_dark).
#   Example: DART_PAD_DOCKERFILE=/Users/lohnn/Programming/flutter_in_the_dark/deploy/Dockerfile.dart-services
# ---------------------------------------------------------------------------
DART_PAD_DOCKERFILE=/absolute/path/to/this/checkout/deploy/Dockerfile.dart-services

# ---------------------------------------------------------------------------
# Optional: default model for generation (room service + dart_services).
# BERGET_MODEL=moonshotai/Kimi-K3
# Optional: basic-auth users file entry if you enable it (usually unused —
# the admin gate is the tailnet interface, not HTTP basic auth).
# BASIC_AUTH_USERS=
# ---------------------------------------------------------------------------

# NOTE: the Berget refresh token and the Cloudflare tunnel token are NOT here.
# They live in deploy/env/dart_services.env and deploy/env/cloudflared.env
# (see the matching .example files). Keep secrets out of this file too.
