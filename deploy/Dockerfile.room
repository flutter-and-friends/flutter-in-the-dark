# Flutter in the Dark room-state service (Dart shelf).
#
# Build context: apps/flutter_in_the_dark/room_service (see docker-compose.yml).
#
#   docker build -f ../../deploy/Dockerfile.room -t flutter-in-the-dark-room:local .

FROM dart:3.13 AS build
WORKDIR /app
COPY pubspec.yaml pubspec.lock ./
RUN dart pub get
COPY bin bin
COPY lib lib
# The challenge catalog is read from disk at startup (challenges/<slug>/source.dart,
# CWD-relative in the runtime stage, so it lands at /app/challenges). Without this
# the image has no disk catalog and the picker silently falls back to the seed.
COPY challenges challenges
RUN dart compile exe bin/server.dart -o bin/server

FROM debian:bookworm-slim
RUN useradd --system --uid 10001 --no-create-home fitd
WORKDIR /app
COPY --from=build /app/bin/server /app/server
# Runtime copy: the build-stage COPY above does NOT carry over (multi-stage).
# The registry reads challenges/ relative to CWD (/app here).
COPY --from=build /app/challenges /app/challenges
# The room calls dart_services over the in-cluster network (service name).
# State file lands on the `room-state` volume mounted at /data.
RUN mkdir -p /data && chown fitd /data
USER fitd
EXPOSE 8302
CMD ["/app/server", "--port", "8302", "--backend", "http://dart-services:8300", "--state-file", "/data/room-state.json"]
