# room_service environment — Gemini LLM fallback (WI-027).
#
# Copy to deploy/env/room.env and fill in ON THE EVENT HOST.
# deploy/env/*.env is gitignored (deploy/env/.gitignore) — never commit it.
#
# Verify blind, never print values (W-083/W-149):
#   [ -f deploy/env/room.env ] && echo exists
#   grep -q '^GEMINI_API_KEY=' deploy/env/room.env && echo key-present
#   chmod 600 deploy/env/room.env

# OPTIONAL — Google Gemini API key. When set, generation falls back to
# Gemini if the primary (Berget via dart_services) fails, and the admin
# provider picker can force Gemini live. When unset, the service runs
# Berget-only exactly as before (the picker reports gemini unavailable).
GEMINI_API_KEY=

# OPTIONAL — Gemini model override (default shown).
#GEMINI_MODEL=gemini-2.5-flash
