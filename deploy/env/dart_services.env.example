# dart_services environment — one of TWO secrets files in this stack
# (the other is cloudflared.env, the public-edge tunnel token — WI-101).
#
# Copy to deploy/env/dart_services.env and fill in ON THE EVENT HOST.
# deploy/env/*.env is gitignored (deploy/.gitignore) — never commit it.
#
# Verify blind, never print values (W-083/W-149):
#   [ -f deploy/env/dart_services.env ] && echo exists
#   grep -q '^BERGET_REFRESH_TOKEN=' deploy/env/dart_services.env && echo key-present
#   chmod 600 deploy/env/dart_services.env

# REQUIRED — Berget OAuth refresh token. dart_services exchanges it for a
# bearer token (POST $BERGET_API_URL/v1/auth/refresh); the refresh token
# itself is rejected on /chat/completions (I-347 — already handled in the
# fork's generative_ai.dart, do not "fix" it).
BERGET_REFRESH_TOKEN=

# OPTIONAL — generation model (default shown). The admin picker in the app
# overrides this live after boot.
#BERGET_MODEL=openai/gpt-oss-120b

# OPTIONAL — OpenAI-compatible endpoint (default shown).
#BERGET_API_URL=https://api.berget.ai
